# Copy to backend/.env (never commit .env). Environment variables override these values.

# ---------- Supabase Auth ----------
# Project URL (Supabase > Project Settings > API), e.g. https://your-project.supabase.co
# Required when the project signs tokens with asymmetric keys (ES256 / RS256, the default
# for recent projects): the API fetches the public keys from <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=
# Legacy HS256 JWT secret (Project Settings > API > JWT Secret).
# Leave empty if the project uses asymmetric signing keys.
SUPABASE_JWT_SECRET=

# ---------- Video module ("capsule vidéo") ----------
# Only needed with the optional dependency group: uv sync --group video
# Without it, POST /sources/video and POST /ask answer 503.

# Folder of the faster-whisper model (config.json, model.bin, tokenizer.json...).
# Default: backend/storage/models/whisper (ignored by git).
WHISPER_MODEL_DIR=D:\Transcription\Model

# Windows + NVIDIA GPU only: folder holding the CUDA DLLs needed by faster-whisper
# (cublas64_12.dll, cublasLt64_12.dll, cudnn*64_9.dll). Leave empty on Linux / CPU.
CUDA_DLL_DIR=D:\Transcription

# Optional settings (defaults shown)
# WHISPER_DEVICE=cuda                 # "cpu" if there is no NVIDIA GPU
# WHISPER_COMPUTE_TYPE=int8_float16   # "int8" on CPU
# OLLAMA_URL=http://localhost:11434   # Ollama must have qwen2.5:3b (ollama pull qwen2.5:3b)
# VIDEO_STORAGE_DIR=                  # default: backend/storage (uploaded videos)
# VIDEO_MAX_BYTES=2147483648          # 2 GB upload limit
