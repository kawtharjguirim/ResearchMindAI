@incollection{stute1995statistical,
title = "Kaplan–Meier Integrals",
series = "Handbook of Statistics",
publisher = "Elsevier",
volume = "23",
pages = "87 - 104",
year = "2003",
booktitle = "Advances in Survival Analysis",
issn = "0169-7161",
doi = "https://doi.org/10.1016/S0169-7161(03)23005-4",
url = "http://www.sciencedirect.com/science/article/pii/S0169716103230054",
author = "Winfried Stute",
abstract = "Publisher Summary
The Kaplan–Meier (K–M) integrals are analogs of empirical integrals when the data are subject to right censoring. They may be viewed as basic statistics to which more complicated quantities may be traced back through linearization. This chapter reviews the most important properties of K–M integrals: strong and distributional convergence as well as bias and variance issues. K-M integrals (or sums) have interesting applications in multivariate statistics and their strong consistency along with distributional convergence is discussed. Bias considerations are surprisingly difficult now and are dealt with in the chapter. Issues related to variance estimation are reviewed and many extensions and applications to the regression setting are also summarized."
}


