@article{Crone10,
author = {Crone, Timothy J. and Tolstoy, Maya},
title = {{Magnitude of the 2010 Gulf of Mexico Oil Leak}},
journal = {Science},
volume = {330},
number = {6004},
pages = {634-},
doi = {10.1126/science.1195840},
year = {2010},
abstract = {To fully understand the environmental and ecological impacts of the Deepwater Horizon disaster, an accurate estimate of the total oil released is required. We used optical plume velocimetry to estimate the velocity of fluids issuing from the damaged well both before and after the collapsed riser pipe was removed. We then calculated the volumetric flow rate under a range of assumptions. With a liquid oil fraction of 0.4, we estimated that the average flow rate from 22 April 2010 to 3 June 2010 was 5.6 x 104 {+/-} 21\% barrels/day (1.0 x 10-1 meter3/second), excluding secondary leaks. After the riser was removed, the flow was 6.8 x 104 {+/-} 19\% barrels/day (1.2 x 10-1 meters3/second). Taking into account the oil collected at the seafloor, this suggests that 4.4 x 106 {+/-} 20\% barrels of oil (7.0 x 105 meters3) was released into the ocean.
},
URL = {http://www.sciencemag.org/cgi/content/abstract/330/6004/634},
eprint = {http://www.sciencemag.org/cgi/reprint/330/6004/634.pdf}
}

