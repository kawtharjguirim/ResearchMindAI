	pmcid = {PMC5987203},
	keywords = {Adult, Brain, Female, Fetus, Humans, Magnetic Resonance Imaging, Neuroimaging, Pregnancy, Prenatal Diagnosis, Prospective Studies, Young Adult},
	pages = {209--220},
}


