@article{lebel_transverse_2010,
	title = {Transverse relaxometry with stimulated echo compensation},
	volume = {64},
	issn = {0740-3194},
	doi = {10.1002/mrm.22487},
	abstract = {{\textless}p{\textgreater} Presented is a fitting model for transverse relaxometry data acquired with the multiple‐refocused spin‐echo sequence. The proposed model, requiring no additional data input or pulse sequence modifications, compensates for imperfections in the transmit field and radiofrequency (RF) profiles. Exploiting oscillatory echo behavior to estimate alternate coherence pathways, the model compensates for prolonged signal decay from stimulated echo pathways yielding precise monoexponential {\textless}italic{\textgreater}T{\textless}/italic{\textgreater} $_{\textrm{2}}$ quantification. Verified numerically and experimentally at 4.7 T in phantoms and the human brain, over 95\% accuracy is readily attainable in realistic imaging situations without sacrificing multislice capabilities or requiring composite or adiabatic RF pulses. The proposed model allows {\textless}italic{\textgreater}T{\textless}/italic{\textgreater} $_{\textrm{2}}$ quantitation in heterogeneous transmit fields and permits thin refocusing widths for efficient multislice imaging. Magn Reson Med, 2010. © 2010 Wiley‐Liss, Inc. {\textless}/p{\textgreater}},
	number = {4},
	journal = {Magnetic Resonance in Medicine},
	author = {Lebel, R. Marc and Wilman, Alan H.},
	month = oct,
	year = {2010},
	pages = {1005--1014},
}

