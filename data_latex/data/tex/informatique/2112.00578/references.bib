@inproceedings{gordon_reporting_2013,
	title = {Reporting {Bias} and {Knowledge} {Acquisition}},
	isbn = {978-1-4503-2411-3},
	url = {http://doi.acm.org/10.1145/2509558.2509563},
	doi = {10.1145/2509558.2509563},
