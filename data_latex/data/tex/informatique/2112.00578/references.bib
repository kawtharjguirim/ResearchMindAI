}

@inproceedings{andreas_alignment-based_2015,
	title = {Alignment-{Based} {Compositional} {Semantics} for {Instruction} {Following}},
	url = {https://arxiv.org/abs/1508.06491},
	abstract = {This paper describes an alignment-based model for interpreting natural language in-structions in context. We approach in-struction following as a search over plans, scoring sequences of actions conditioned on structured observations of text and the environment. By explicitly modeling both the low-level compositional structure of individual actions and the high-level struc-ture of full plans, we are able to learn both grounded representations of sentence meaning and pragmatic constraints on in-terpretation. To demonstrate the model’s flexibility, we apply it to a diverse set of benchmark tasks. On every task, we outperform strong task-specific baselines, and achieve several new state-of-the-art results. 1},
	booktitle = {Proceedings of the 2015 {Conference} on {Empirical} {Methods} in {Natural} {Language} {Processing}},
	author = {Andreas, Jacob and Klein, Dan},
	year = {2015},
	keywords = {AGILE, grounding},
}

