@inproceedings{macmahon_walk_2006,
	title = {Walk the {Talk}: {Connecting} {Language}, {Knowledge}, {Action} in {Route} {Instructions}},
	shorttitle = {Walk the {Talk}},
	abstract = {Following verbal route instructions requires knowledge of  language, space, action and perception. We present MARCO,  an agent that follows free-form, natural language route  instructions by representing and executing a sequence of  compound action specifications that model which actions  to take under which conditions. MARCO infers implicit  actions from knowledge of both linguistic conditional phrases  and from spatial action and local configurations. Thus,  MARCO performs explicit actions, implicit actions necessary  to achieve the stated conditions, and exploratory actions to  learn about the world.},
	booktitle = {In {Proc}. of the {Nat}. {Conf}. on {Artificial} {Intelligence} ({AAAI}},
	author = {Macmahon, Matt and Stankiewicz, Brian and Kuipers, Benjamin},
	year = {2006},
	keywords = {grounding},
	pages = {1475--1482},
}

@inproceedings{tellex_understanding_2011,
	title = {Understanding {Natural} {Language} {Commands} for {Robotic} {Navigation} and {Mobile} {Manipulation}},
