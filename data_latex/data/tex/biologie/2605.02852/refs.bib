  author = {{Ripoll-S{\'a}nchez}, Lidia and Watteyne, Jan and Sun, HaoSheng and Fernandez, Robert and Taylor, Seth R. and Weinreb, Alexis and Bentley, Barry L. and Hammarlund, Marc and Miller, III, David M. and Hobert, Oliver and Beets, Isabel and V{\'e}rtes, Petra E. and Schafer, William R.},
